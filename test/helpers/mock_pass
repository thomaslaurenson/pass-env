#!/usr/bin/env bash
# Mock 'pass' executable used by the test suite.
#
# Only 'pass show' is actually mocked: it reads plain-text KEY=VALUE fixture
# files from PASSENV_FIXTURE_CONTENT_DIR instead of decrypting real GPG
# entries. Every 'pass env ...' call is delegated to the real extension
# (src/env.bash), which in turn calls 'pass show' and so resolves back to this
# mock. The wrapper's tests therefore exercise the real extension rather than a
# re-implementation of it, which previously had to be kept in sync by hand.
#
#   pass show -- ENTRY        the only genuinely mocked call
#   pass env <subcommand>...  delegated to src/env.bash
#
# Arguments:
#   $@ - Forwarded pass arguments (see patterns above)
# Environment:
#   PASSENV_FIXTURE_CONTENT_DIR - directory containing plain-text fixture files
#   PASS_ENV_SRC                - path to the real src/env.bash (set by tests)
# Outputs:
#   stdout: entry content (show) or the extension's output (env)
#   stderr: error messages on unknown commands or missing fixtures
# Returns:
#   0 on success
#   1 on unrecognised command or missing fixture; otherwise the extension's status

FIXTURE_DIR="${PASSENV_FIXTURE_CONTENT_DIR:-$(cd "$(dirname "$0")/../fixtures/content" && pwd)}"

case "${1:-}" in
  show)
    [[ "${2:-}" == "--" ]] || { printf 'mock_pass: expected: show -- ENTRY\n' >&2; exit 1; }
    entry="${3:-}"
    fixture="$FIXTURE_DIR/$entry"
    [[ -f "$fixture" ]] || { printf 'mock_pass: no fixture for: %s\n' "$entry" >&2; exit 1; }
    cat "$fixture"
    ;;
  env)
    shift  # consume 'env'; the rest is the extension's own argument list
    env_bash="${PASS_ENV_SRC:-$(cd "$(dirname "$0")/../.." && pwd)/src/env.bash}"
    [[ -f "$env_bash" ]] || { printf 'mock_pass: cannot find env.bash at: %s\n' "$env_bash" >&2; exit 1; }
    exec bash "$env_bash" "$@"
    ;;
  *)
    printf 'mock_pass: unknown command: %s\n' "$*" >&2
    exit 1
    ;;
esac
